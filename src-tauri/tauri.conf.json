{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marol",
  "version": "0.9.2",
  "identifier": "dev.marol.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Marol",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExNTQ0MDA4NDRCQUE4OUIKUldTYnFMcEVDRUJVb2VZTHJ0Mk8yazVoUVdBaG1BS3oxbDJwZUk5OEZSYS9nNXYzRGxGS2JoVkwK",
      "endpoints": [
        "https://github.com/KCL1104/marol/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["deb", "rpm", "appimage", "app", "dmg", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "publisher": "Marol",
    "homepage": "https://github.com/kcl1104/marol",
    "copyright": "Copyright (c) 2026 Marol contributors",
    "shortDescription": "Run and supervise multiple coding agent sessions, each in its own git worktree",
    "longDescription": "Marol is a local-first desktop console for running and supervising multiple coding agent sessions, with git worktree isolation, lifecycle hooks and native notifications.",
    "linux": {
      "deb": {
        "depends": ["git"],
        "recommends": ["gh"],
        "section": "devel"
      },
      "rpm": {
        "depends": ["git"],
        "recommends": ["gh"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
